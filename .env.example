# Active local portal: guest, management or admin. Scripts select this automatically.
APP_PORTAL=guest
# Clerk identity provider. Use one Clerk application for the three Vabbot portals.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional, enables networkless verification in the dedicated Node backend.
CLERK_JWT_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
# Comma-separated portal origins accepted by Clerk token verification.
CLERK_AUTHORIZED_PARTIES=http://localhost:3000,http://localhost:3001,http://localhost:3002
# Optional shared SQLite path for all three local portals.
# DATABASE_PATH=C:/path/to/finder.sqlite
# Set privately for npm run admin:create; no default credentials.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# PostgreSQL/NextAuth foundation, not the active local portal store:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/vabbot?schema=public
# NEXTAUTH_SECRET=
# NEXTAUTH_URL=http://localhost:3000

# Stripe Step 1: UK business, GBP. Test mode only; enable on the guest portal.
STRIPE_PAYMENTS_ENABLED=false
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# No publishable key is needed for the server-side foundation.
