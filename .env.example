# Active local portal: guest, management or admin. Scripts select this automatically.
APP_PORTAL=guest
# Clerk identity provider. Use one Clerk application for the three Vabbot portals.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional, enables networkless verification in the dedicated Node backend.
CLERK_JWT_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
# Comma-separated portal origins accepted by Clerk token verification.
CLERK_AUTHORIZED_PARTIES=http://localhost:3000,http://localhost:3001,http://localhost:3002
# Dedicated Node API. Browser requests go through the authenticated Next.js proxy.
BACKEND_API_URL=http://127.0.0.1:4000
BACKEND_PORT=4000
BACKEND_HOST=127.0.0.1
BACKEND_ALLOWED_ORIGIN=http://localhost:3001
# Set privately for npm run admin:create. Use the same email as the Clerk account.
# ADMIN_EMAIL=
# Optional: link the Clerk user immediately instead of linking by email on first sign-in.
# ADMIN_CLERK_USER_ID=
# Prisma Postgres: pooled URL for runtime and direct URL for migrations/backups.
DATABASE_URL=postgresql://USER:PASSWORD@POOLED_HOST:5432/vabbot?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@DIRECT_HOST:5432/vabbot?sslmode=require
# Source used only during the one-time production import.
# SQLITE_SOURCE_PATH=C:/path/to/finder.sqlite
# MIGRATION_DEFAULT_COUNTRY=Malawi
# MIGRATE_BLOBS=true
# NEXTAUTH_SECRET=
# NEXTAUTH_URL=http://localhost:3000

# Commercial policy. Defaults selected for launch and adjustable without code changes.
PLATFORM_COMMISSION_BPS=1200
PAYOUT_SCHEDULE=weekly
PAYOUT_RESERVE_DAYS=7
FREE_CANCELLATION_HOURS=48
PARTIAL_REFUND_HOURS=24
PARTIAL_REFUND_BPS=5000

# Stripe UK platform, GBP, and Connect Express.
STRIPE_PAYMENTS_ENABLED=false
STRIPE_CONNECT_ENABLED=false
STRIPE_ACCOUNT_COUNTRY=GB
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# No publishable key is needed for the server-side foundation.

# Cloudflare R2. Keep verification documents and backups in private buckets.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=vabbot-uploads
R2_BACKUP_BUCKET=vabbot-backups
# Public custom domain used only for public property images.
R2_PUBLIC_BASE_URL=https://media.example.com

# Mapbox Geocoding v6. Use a restricted server token.
MAPBOX_ACCESS_TOKEN=
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Transactional email and SMS.
RESEND_API_KEY=
EMAIL_FROM=Vabbot Resorts <bookings@example.com>
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Deployed portal and API origins.
GUEST_APP_URL=https://www.example.com
MANAGER_APP_URL=https://manage.example.com
ADMIN_APP_URL=https://admin.example.com
BACKEND_API_URL=https://api.example.com
CRON_SECRET=
