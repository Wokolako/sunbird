# Active local portal: guest, management or admin. Scripts select this automatically.
APP_PORTAL=guest
# Optional shared SQLite path for all three local portals.
# DATABASE_PATH=C:/path/to/finder.sqlite
# Set privately for npm run admin:create; no default credentials.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# PostgreSQL/NextAuth foundation, not the active local portal store:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/vabbot?schema=public
# NEXTAUTH_SECRET=
# NEXTAUTH_URL=http://localhost:3000
