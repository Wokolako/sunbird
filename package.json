{
  "name": "vabbot-resorts",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "backend:dev": "tsx backend/server.ts",
    "lint": "eslint app components hooks lib middleware.ts tests --ext .ts,.tsx",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "test": "tsx tests/auth-guard.test.ts && tsx tests/inventory.test.ts && tsx tests/pms.test.ts && tsx tests/stripe-payments.test.ts",
    "typecheck": "tsc --noEmit",
    "dev:guest": "node scripts/run-portal.mjs guest dev",
    "dev:manage": "node scripts/run-portal.mjs management dev",
    "dev:admin": "node scripts/run-portal.mjs admin dev",
    "build:manage": "node scripts/run-portal.mjs management build",
    "build:admin": "node scripts/run-portal.mjs admin build",
    "start:manage": "node scripts/run-portal.mjs management start",
    "start:admin": "node scripts/run-portal.mjs admin start",
    "admin:create": "node scripts/create-admin.mjs",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@clerk/backend": "^3.26.2",
    "@clerk/nextjs": "^7.9.20",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.553.0",
    "next": "^15.4.9",
    "next-auth": "^4.24.15",
    "prisma": "^6.19.3",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "stripe": "^23.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.6.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.4.9",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
