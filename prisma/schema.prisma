datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// =============================================================================
// ENUMS
// =============================================================================

enum UserRole {
  GUEST
  OWNER
  MANAGER
  FRONT_DESK
  HOUSEKEEPER
  ADMIN
}

enum PropertyType {
  HOTEL
  LODGE
}

enum PropertyStatus {
  PENDING
  APPROVED
  SUSPENDED
}

enum StaffRole {
  OWNER
  MANAGER
  FRONT_DESK
  HOUSEKEEPER
}

enum RoomUnitStatus {
  VACANT_CLEAN
  VACANT_DIRTY
  OCCUPIED
  MAINTENANCE
}

enum ReservationStatus {
  UPCOMING
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

enum ReservationSource {
  ONLINE
  WALK_IN
  PHONE
}

enum IdVerificationStatus {
  NOT_VERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum PaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  MOBILE_MONEY
  BANK_TRANSFER
  CASH
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentType {
  DEPOSIT
  FULL
  PARTIAL
  REFUND
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  CANCELLED
}

enum RateRuleType {
  WEEKDAY_WEEKEND
  SEASONAL
  MIN_STAY
  RESTRICTION
  CUSTOM
}

enum DateBlockReason {
  MAINTENANCE
  PRIVATE_BOOKING
  OWNER_STAY
  RENOVATION
}

enum PayoutSchedule {
  WEEKLY
  BI_WEEKLY
  MONTHLY
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

// =============================================================================
// AUTHENTICATION & USERS
// =============================================================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  role          UserRole  @default(GUEST)
  phone         String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // NextAuth
  accounts      Account[]
  sessions      Session[]

  // Profiles & Portals
  guestProfile   GuestProfile?
  staffProfiles  PropertyStaff[]
  reservations   Reservation[]
  reviews        Review[]
  messagesSent   Message[]     @relation("SentMessages")
  messagesRecv   Message[]     @relation("ReceivedMessages")
  auditLogs      AuditLog[]

  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model GuestProfile {
  id                    String   @id @default(cuid())
  userId                String   @unique
  phone                 String?
  address               String?
  city                  String?
  stateOrRegion         String?
  country               String?  @default("United Kingdom")
  postalCode            String?
  emergencyContactName  String?
  emergencyContactPhone String?
  idOrPassportNumber    String?
  nationality           String?
  preferredCurrency     String   @default("GBP")
  paymentMethodPref     String?
  specialRequests       String?  @db.Text
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// =============================================================================
// PROPERTY & AMENITIES
// =============================================================================

model Property {
  id                 String         @id @default(cuid())
  name               String
  legalName          String?
  slug               String         @unique
  type               PropertyType   @default(LODGE)
  status             PropertyStatus @default(PENDING)
  registrationNumber String?
  taxId              String?
  description        String         @db.Text
  address            String
  city               String
  stateOrRegion      String
  country            String         @default("United Kingdom")
  postalCode         String?
  latitude           Float?
  longitude          Float?
  starRating         Float?
  contactEmail       String?
  contactPhone       String?
  website            String?
  rules              String?        @db.Text
  quietHours         String?
  petsAllowed        Boolean        @default(false)
  smokingAllowed     Boolean        @default(false)
  checkInTime        String         @default("14:00")
  checkOutTime       String         @default("10:00")
  cancellationPolicy String?        @db.Text
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  staff              PropertyStaff[]
  amenities          PropertyAmenity[]
  photos             PropertyPhoto[]
  roomCategories     RoomCategory[]
  roomUnits          RoomUnit[]
  reservations       Reservation[]
  rateRules          RateRule[]
  dateBlocks         DateBlock[]
  reviews            Review[]
  messages           Message[]
  commissionSetting  CommissionSetting?
  payouts            Payout[]
  invoices           Invoice[]

  @@index([status, type, city, country])
  @@index([latitude, longitude])
  @@index([starRating])
}

model PropertyStaff {
  id         String    @id @default(cuid())
  propertyId String
  userId     String
  role       StaffRole @default(MANAGER)
  assignedAt DateTime  @default(now())
  active     Boolean   @default(true)

  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([propertyId, userId])
  @@index([userId, role])
}

model Amenity {
  id         String            @id @default(cuid())
  name       String            @unique
  slug       String            @unique
  icon       String?
  category   String            @default("GENERAL") // GENERAL, ROOM, OUTDOOR, WELLNESS

  properties PropertyAmenity[]
}

model PropertyAmenity {
  propertyId String
  amenityId  String
  isFeatured Boolean  @default(false)

  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenity    Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([propertyId, amenityId])
}

model PropertyPhoto {
  id           String   @id @default(cuid())
  propertyId   String
  url          String
  caption      String?
  isHero       Boolean  @default(false)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, displayOrder])
}

// =============================================================================
// ROOM CATEGORIES & ROOM UNITS (PMS INVENTORY)
// =============================================================================

model RoomCategory {
  id             String        @id @default(cuid())
  propertyId     String
  name           String
  slug           String
  description    String        @db.Text
  capacity       Int           @default(2)
  maxAdults      Int           @default(2)
  maxChildren    Int           @default(0)
  bedArrangement String        // e.g. "1 King Bed" or "2 Twin Beds"
  basePrice      Decimal       @db.Decimal(12, 2)
  amenities      String[]      @default([])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  property       Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomUnits      RoomUnit[]
  rateRules      RateRule[]
  reservations   Reservation[]

  @@unique([propertyId, slug])
  @@index([propertyId, basePrice, capacity])
}

model RoomUnit {
  id             String         @id @default(cuid())
  propertyId     String
  roomCategoryId String
  name           String         // e.g. "Room 101", "Chalet 4"
  floor          String?
  status         RoomUnitStatus @default(VACANT_CLEAN)
  notes          String?        @db.Text
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  property       Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomCategory   RoomCategory   @relation(fields: [roomCategoryId], references: [id], onDelete: Cascade)
  reservations   Reservation[]
  dateBlocks     DateBlock[]

  @@unique([propertyId, name])
  @@index([propertyId, status])
  @@index([roomCategoryId])
}

// =============================================================================
// RESERVATIONS & BOOKINGS (NO DOUBLE-BOOKING)
// =============================================================================

model Reservation {
  id                   String               @id @default(cuid())
  referenceCode        String               @unique // e.g. "RES-2026-001"
  propertyId           String
  roomCategoryId       String
  roomUnitId           String?              // Assigned room unit
  guestId              String
  status               ReservationStatus    @default(UPCOMING)
  source               ReservationSource    @default(ONLINE)
  checkInDate          DateTime             @db.Date
  checkOutDate         DateTime             @db.Date
  adultsCount          Int                  @default(1)
  childrenCount        Int                  @default(0)
  specialRequests      String?              @db.Text
  idVerificationStatus IdVerificationStatus @default(NOT_VERIFIED)
  totalAmount          Decimal              @db.Decimal(12, 2)
  currency             String               @default("GBP")
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  property             Property             @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomCategory         RoomCategory         @relation(fields: [roomCategoryId], references: [id], onDelete: Cascade)
  roomUnit             RoomUnit?            @relation(fields: [roomUnitId], references: [id], onDelete: SetNull)
  guest                User                 @relation(fields: [guestId], references: [id], onDelete: Cascade)
  addOns               ReservationAddOn[]
  payments             Payment[]
  invoices             Invoice[]
  review               Review?

  @@index([propertyId, checkInDate, checkOutDate, status])
  @@index([guestId])
  @@index([roomUnitId])
}

model ReservationAddOn {
  id            String      @id @default(cuid())
  reservationId String
  name          String      // e.g. "Breakfast Buffet", "Airport Shuttle", "Boat Cruise"
  unitPrice     Decimal     @db.Decimal(12, 2)
  quantity      Int         @default(1)
  totalPrice    Decimal     @db.Decimal(12, 2)
  createdAt     DateTime    @default(now())

  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId])
}

model Payment {
  id                   String        @id @default(cuid())
  reservationId        String
  amount               Decimal       @db.Decimal(12, 2)
  currency             String        @default("GBP")
  method               PaymentMethod @default(CREDIT_CARD)
  status               PaymentStatus @default(PENDING)
  paymentType          PaymentType   @default(FULL)
  transactionReference String?
  paidAt               DateTime?
  createdAt            DateTime      @default(now())

  reservation          Reservation   @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId, status])
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique // e.g. "INV-2026-0001"
  reservationId String
  propertyId    String
  subtotal      Decimal       @db.Decimal(12, 2)
  taxAmount     Decimal       @db.Decimal(12, 2)
  totalAmount   Decimal       @db.Decimal(12, 2)
  currency      String        @default("GBP")
  status        InvoiceStatus @default(ISSUED)
  issuedAt      DateTime      @default(now())
  paidAt        DateTime?
  pdfUrl        String?

  reservation   Reservation   @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  property      Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, invoiceNumber])
}

// =============================================================================
// RATE RULES & DYNAMIC PRICING
// =============================================================================

model RateRule {
  id              String        @id @default(cuid())
  propertyId      String
  roomCategoryId  String?
  name            String
  type            RateRuleType  @default(SEASONAL)
  startDate       DateTime?     @db.Date
  endDate         DateTime?     @db.Date
  daysOfWeek      Int[]         @default([]) // 0=Sun, 1=Mon, ..., 6=Sat
  priceMultiplier Decimal?      @db.Decimal(5, 2) // e.g. 1.25 for +25%
  fixedPrice      Decimal?      @db.Decimal(12, 2) // direct price override
  minStayDays     Int           @default(1)
  maxStayDays     Int?
  restrictions    String?       @db.Text // JSON or custom restriction rules
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  property        Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomCategory    RoomCategory? @relation(fields: [roomCategoryId], references: [id], onDelete: Cascade)

  @@index([propertyId, roomCategoryId, startDate, endDate])
}

// =============================================================================
// DATE BLOCKS (MAINTENANCE & PRIVATE BOOKINGS)
// =============================================================================

model DateBlock {
  id         String          @id @default(cuid())
  propertyId String
  roomUnitId String
  startDate  DateTime        @db.Date
  endDate    DateTime        @db.Date
  reason     DateBlockReason @default(MAINTENANCE)
  notes      String?         @db.Text
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  property   Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomUnit   RoomUnit        @relation(fields: [roomUnitId], references: [id], onDelete: Cascade)

  @@index([propertyId, roomUnitId, startDate, endDate])
}

// =============================================================================
// REVIEWS, MESSAGES & COMMUNICATION
// =============================================================================

model Review {
  id             String      @id @default(cuid())
  reservationId  String      @unique
  propertyId     String
  guestId        String
  rating         Int         // 1 to 5
  cleanliness    Int?        // 1 to 5
  staff          Int?        // 1 to 5
  location       Int?        // 1 to 5
  valueForMoney  Int?        // 1 to 5
  title          String?
  comment        String      @db.Text
  ownerReply     String?     @db.Text
  repliedAt      DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  reservation    Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  property       Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  guest          User        @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([propertyId, rating])
}

model Message {
  id            String      @id @default(cuid())
  propertyId    String?
  reservationId String?
  senderId      String
  recipientId   String
  subject       String?
  content       String      @db.Text
  isRead        Boolean     @default(false)
  createdAt     DateTime    @default(now())

  property      Property?   @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  sender        User        @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipient     User        @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, isRead])
  @@index([propertyId])
}

// =============================================================================
// FINANCIALS, COMMISSIONS & PAYOUTS
// =============================================================================

model CommissionSetting {
  id             String         @id @default(cuid())
  propertyId     String         @unique
  percentage     Decimal        @default(10.00) @db.Decimal(5, 2) // e.g. 10.00%
  payoutSchedule PayoutSchedule @default(MONTHLY)
  effectiveFrom  DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  property       Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model Payout {
  id              String       @id @default(cuid())
  propertyId      String
  payoutReference String       @unique // e.g. "PO-2026-10-001"
  periodStart     DateTime     @db.Date
  periodEnd       DateTime     @db.Date
  grossRevenue    Decimal      @db.Decimal(12, 2)
  commissionRate  Decimal      @db.Decimal(5, 2)
  commissionFee   Decimal      @db.Decimal(12, 2)
  netPayout       Decimal      @db.Decimal(12, 2)
  currency        String       @default("GBP")
  status          PayoutStatus @default(PENDING)
  processedAt     DateTime?
  bankReference   String?
  createdAt       DateTime     @default(now())

  property        Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, status])
}

// =============================================================================
// PLATFORM AUDIT LOG
// =============================================================================

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userEmail String?
  action    String
  entity    String
  entityId  String?
  details   String?  @db.Text
  ipAddress String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([userId])
}
