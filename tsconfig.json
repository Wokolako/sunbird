{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    ".next-admin/types/**/*.ts",
    ".next-management/types/**/*.ts",
    ".next-test-guest/types/**/*.ts",
    ".next-test-management/types/**/*.ts",
    ".next/types/**/*.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "backend/**/*.ts",
    "components/**/*.tsx",
    "hooks/**/*.ts",
    "lib/**/*.ts",
    "middleware.ts",
    "next-env.d.ts",
    "prisma/**/*.ts",
    "tests/**/*.ts",
    "types/**/*.d.ts",
    ".next-test-admin/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
